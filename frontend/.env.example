# Copy this to .env and fill in your own. See src/api/client.js for how
# this is read - every request in the app goes through that one client.

# The backend's own base URL, including the /api prefix. Point this at a
# local uvicorn for development, or the deployed backend's public URL for
# a real deploy (e.g. https://your-backend.onrender.com/api). Defaults to
# http://localhost:8000/api if left unset.
VITE_API_BASE_URL=http://localhost:8000/api
