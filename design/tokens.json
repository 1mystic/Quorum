{
  "$meta": {
    "name": "Quorum",
    "card": "B.4",
    "sourceOfTruth": "design/tokens.css",
    "rules": [
      "Every colour is defined for light on bare :root and redefined for dark twice.",
      "Brand colour and chart colour are separate systems.",
      "--accent means actionable, never warning. Status has its own ramps.",
      "Easings are cubic-bezier. Constant velocity is --ease-constant, never the linear keyword."
    ]
  },
  "colour": {
    "surface": {
      "--canvas": {
        "light": "#FAF7F2",
        "dark": "#12100E"
      },
      "--canvas-2": {
        "light": "#F3EFE8",
        "dark": "#0C0A09"
      },
      "--panel": {
        "light": "#FFFFFF",
        "dark": "#1B1815"
      },
      "--panel-2": {
        "light": "#F7F4EE",
        "dark": "#211D19"
      }
    },
    "ink": {
      "--ink": {
        "light": "#1A1714",
        "dark": "#F4F0EA"
      },
      "--ink-2": {
        "light": "#544E47",
        "dark": "#B5ADA2"
      },
      "--ink-3": {
        "light": "#8A8278",
        "dark": "#877F74"
      },
      "--ink-4": {
        "light": "#B8AFA3",
        "dark": "#5E574E"
      }
    },
    "brand": {
      "--brand": {
        "light": "#13594A",
        "dark": "#3DA88C"
      },
      "--brand-hi": {
        "light": "#1B7561",
        "dark": "#54C0A2"
      },
      "--brand-soft": {
        "light": "#DDEBE4",
        "dark": "#123028"
      },
      "--accent": {
        "light": "#E07A3F",
        "dark": "#F09155"
      },
      "--accent-soft": {
        "light": "#FBE8DA",
        "dark": "#332013"
      }
    },
    "hairline": {
      "--hair": {
        "light": "#E6DFD4",
        "dark": "#2C2722"
      },
      "--hair-2": {
        "light": "#D3C9BA",
        "dark": "#403830"
      }
    },
    "status": {
      "--ok": {
        "light": "#1C7A47",
        "dark": "#43B573"
      },
      "--ok-bg": {
        "light": "#E2F0E7",
        "dark": "#12281B"
      },
      "--warn": {
        "light": "#8A6209",
        "dark": "#D3A544"
      },
      "--warn-bg": {
        "light": "#F8EFD9",
        "dark": "#2B2210"
      },
      "--stop": {
        "light": "#A33327",
        "dark": "#E0705F"
      },
      "--stop-bg": {
        "light": "#F9E4E0",
        "dark": "#2E1A16"
      }
    },
    "dataviz": {
      "--s1": {
        "light": "#2F6F9F",
        "dark": "#4C90CB"
      },
      "--s2": {
        "light": "#C0562F",
        "dark": "#D4703F"
      },
      "--s3": {
        "light": "#7A5AA8",
        "dark": "#9A7AD8"
      },
      "--s4": {
        "light": "#B58500",
        "dark": "#C79A22"
      },
      "--s5": {
        "light": "#2E8B6F",
        "dark": "#46B394"
      },
      "--s6": {
        "light": "#9C4F6E",
        "dark": "#C9748F"
      },
      "--chart": {
        "light": "#FFFFFF",
        "dark": "#1B1815"
      },
      "--grid": {
        "light": "#EDE7DC",
        "dark": "#26221D"
      },
      "--axis": {
        "light": "#CFC5B6",
        "dark": "#403830"
      },
      "--limit": {
        "light": "#C0562F",
        "dark": "#D4703F"
      },
      "--band-alpha": {
        "light": ".16",
        "dark": ".22"
      }
    }
  },
  "type": {
    "family": {
      "--font-display": "'Bricolage Grotesque',ui-sans-serif,system-ui,sans-serif",
      "--font-text": "'Inter Tight',ui-sans-serif,system-ui,sans-serif",
      "--font-mono": "'JetBrains Mono',ui-monospace,'SFMono-Regular',monospace"
    },
    "size": {
      "--fs-micro": "10.5px",
      "--fs-label": "11.5px",
      "--fs-small": "13px",
      "--fs-body": "16px",
      "--fs-lead": "18px",
      "--fs-h3": "1.2rem",
      "--fs-h2": "clamp(1.9rem,3.6vw,3.1rem)",
      "--fs-h1": "clamp(2.9rem,7.2vw,6.2rem)",
      "--fs-stat": "clamp(2.6rem,4.4vw,3.4rem)"
    },
    "metric": {
      "--lh-tight": "1.04",
      "--lh-snug": "1.28",
      "--lh-body": "1.62",
      "--ls-display": "-.045em",
      "--ls-heading": "-.032em",
      "--ls-label": ".14em"
    }
  },
  "space": {
    "--sp1": "4px",
    "--sp2": "8px",
    "--sp3": "12px",
    "--sp4": "16px",
    "--sp5": "24px",
    "--sp6": "32px",
    "--sp7": "48px",
    "--sp8": "64px",
    "--sp9": "96px",
    "--sp10": "128px"
  },
  "radius": {
    "--r-sm": "6px",
    "--r": "10px",
    "--r-lg": "16px",
    "--r-pill": "999px"
  },
  "elevation": {
    "--shadow-card": {
      "light": "0 1px 2px rgba(26,23,20,.02),0 8px 28px -12px rgba(26,23,20,.10)",
      "dark": "0 1px 2px rgba(0,0,0,.24),0 8px 28px -12px rgba(0,0,0,.55)"
    },
    "--shadow-pop": {
      "light": "0 2px 6px rgba(26,23,20,.04),0 18px 48px -16px rgba(26,23,20,.18)",
      "dark": "0 2px 6px rgba(0,0,0,.3),0 18px 48px -16px rgba(0,0,0,.65)"
    },
    "--surface-inverse": {
      "light": "#1A1714",
      "dark": "#1A1714",
      "note": "fixed, does not invert with theme: for a card that must always read as the opposite of the page (CTA band, toast banner)"
    },
    "--ink-inverse": {
      "light": "#FAF7F2",
      "dark": "#FAF7F2",
      "note": "fixed pair with --surface-inverse"
    }
  },
  "motion": {
    "--ease": "cubic-bezier(.16,1,.3,1)",
    "--ease-snap": "cubic-bezier(.4,0,.2,1)",
    "--ease-constant": "cubic-bezier(0,0,1,1)",
    "--t-hover": "220ms",
    "--t-fill": "520ms",
    "--t-reveal": "640ms",
    "--t-marquee": "58s"
  },
  "layout": {
    "--wrap": "1200px",
    "--wrap-vw": "90vw",
    "--sidebar": "264px"
  },
  "evidenceStates": {
    "estimate": {
      "pill": "--ok",
      "surface": "--ok-bg",
      "meaning": "clean reading"
    },
    "qualified": {
      "pill": "--warn",
      "surface": "--warn-bg",
      "meaning": "non-blocking check failed, value still shown"
    },
    "notInterpretable": {
      "pill": "--stop",
      "surface": "--stop-bg",
      "meaning": "blocking check failed, value suppressed"
    },
    "insufficientData": {
      "pill": "--ink-3",
      "surface": "--panel-2",
      "meaning": "below min_n, deliberately colourless so it never reads as an error"
    }
  }
}
