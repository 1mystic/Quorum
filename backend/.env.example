# The contract: every variable a fresh deploy needs, with a comment on what
# it is. No real secret value below - copy this to .env and fill in your
# own. See docs/RUNNING_LOCALLY.md for the local (Docker or manual) path and
# PLAN.md's "Deploy" section for the web/worker/Neon/Vercel shape this is
# written for.

# ---------------------------------------------------------------------------
# Database (required). Must use the postgresql+asyncpg:// scheme.
# ---------------------------------------------------------------------------
# Local Postgres (manual path, docs/RUNNING_LOCALLY.md): point this at
# whatever role/database you created, e.g.
#   postgresql+asyncpg://quorum_app@127.0.0.1:5544/quorum_dev
# `docker compose up` (see docker-compose.yml) sets this itself; you do not
# need to fill it in for that path.
DATABASE_URL=postgresql+asyncpg://quorum_app@localhost:5432/quorum_dev

# Neon (this project's alpha/production target). Get the connection string
# from the Neon console; it looks like
#   postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
# Rewrite it before pasting here: scheme to postgresql+asyncpg://, and
# sslmode=require&channel_binding=require to ssl=require - asyncpg's
# connect() has no sslmode/channel_binding kwargs and SQLAlchemy passes URL
# query params straight through, so the original libpq-style string crashes
# on connect.
#   DATABASE_URL=postgresql+asyncpg://neondb_owner:REPLACE_ME@your-project-pooler.region.aws.neon.tech/neondb?ssl=require

# Used by `uv run pytest`. Every table is dropped on teardown - point this
# at a throwaway database, never at the same database as DATABASE_URL, and
# create a separate Neon branch/database for it before ever pointing it at
# Neon (never neondb itself).
TEST_DATABASE_URL=postgresql+asyncpg://quorum_app@localhost:5432/quorum_test

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Token signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating this invalidates every issued token.
JWT_SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256

# The frontend origin allowed by CORS. Exact scheme + host + port, no
# trailing slash. The tenant-scope dependency also uses this to build
# password-reset links.
FRONTEND_URL=http://localhost:5173

# This API's own public base URL, used only to build a download link for a
# certificate that fell back to Postgres storage because S3 was unavailable
# (see app/models/certificate.py). Defaults to http://localhost:8000.
BACKEND_BASE_URL=http://localhost:8000

# Google Sign-In client ID (frontend + backend token verification). Leave
# blank to leave Google sign-in disabled; the frontend falls back to a
# stated stub rather than a broken button.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Certificate storage (required). S3-compatible object storage for issued
# event certificates (app/core/storage.py). A failed upload falls back to
# storing the PDF bytes in Postgres itself (Certificate.pdf_data), so this
# not being real does not break certificate issuance in local dev - it just
# means BACKEND_BASE_URL's fallback download link is what gets used.
# ---------------------------------------------------------------------------
AWS_REGION=ap-south-1
S3_BUCKET_NAME=quorum-media
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ---------------------------------------------------------------------------
# Outbound mail (required). Password-reset links and notification emails.
# A Gmail account needs an "app password" (Google Account -> Security ->
# App passwords), not the account password itself.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
MAIL_FROM=yourgmail@gmail.com

# ---------------------------------------------------------------------------
# AI assistant (optional - every one of these has a safe default).
# AI_PROVIDER picks which of the two keys below is used; "auto" picks
# whichever is set, preferring Anthropic. Leaving both keys blank runs the
# assistant in deterministic mock mode, which is what the offline test
# suite relies on and keeps the assistant demoable with no network at all.
# ---------------------------------------------------------------------------
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano
OPENAI_BASE_URL=

# Hard caps for the bounded agent tool-calling loop
# (docs/AI_ARCHITECTURE_DECISIONS.md). Defaults are conservative; tighten
# them for a live demo, loosen them for development.
AGENT_MAX_ITERATIONS=4
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_INPUT_TOKENS=12000
AGENT_DEADLINE_SECONDS=20.0
AGENT_MAX_OUTPUT_TOKENS=400

# ---------------------------------------------------------------------------
# Voice (optional). An empty SARVAM_API_KEY reports realtime voice as
# unavailable and the frontend falls back to the browser's own narrator.
# SARVAM_BUDGET_RUPEES is a hard spend guard, not a display figure - the
# voice router refuses a new paid session once it is reached.
# ---------------------------------------------------------------------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=anushka
SARVAM_SAMPLE_RATE=16000
VOICE_MAX_CONCURRENT_SESSIONS=3
SARVAM_BUDGET_RUPEES=5.0
SARVAM_STT_RUPEES_PER_HOUR=30.0
SARVAM_TTS_RUPEES_PER_10K_CHARS=30.0
VOICE_MAX_SESSION_SECONDS=90.0
VOICE_MAX_REPLY_CHARS=400

# ---------------------------------------------------------------------------
# Worker (optional, read only by scripts/materialize_insights.py, not by
# the web API). How often the worker re-materializes every tenant's Insight
# Packs, in seconds. docs/STATS_API.md's cadence table has nothing coarser
# than "nightly"; the one-hour default satisfies every declared cadence with
# room to spare.
# ---------------------------------------------------------------------------
MATERIALIZE_INTERVAL_SECONDS=3600
